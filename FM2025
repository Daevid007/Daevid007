        "# Slider, um die Mindest-Overall-Bewertung zu filtern\n",
        "overall_slider = widgets.IntSlider(\n",
        "    value=70,\n",
        "    min=50,\n",
        "    max=100,\n",
        "    step=1,\n",
        "    description='Min Overall:',\n",
        "    continuous_update=True,\n",
        ")\n",
        "\n",
        "# Output-Widget für den Plot\n",
        "plot_output = widgets.Output()\n",
        "\n",
        "def update_plot(change):\n",
        "    with plot_output:\n",
        "        clear_output(wait=True)\n",
        "        min_overall = change.new\n",
        "        filtered_players = df_players[df_players['overall'] >= min_overall]\n",
        "\n",
        "        if not filtered_players.empty:\n",
        "            plt.figure(figsize=(10, 6))\n",
        "            filtered_players['overall'].hist(bins=10, edgecolor='black')\n",
        "            plt.title(f'Verteilung der Spieler-Overall-Bewertungen (>= {min_overall})')\n",
        "            plt.xlabel('Overall Bewertung')\n",
        "            plt.ylabel('Anzahl der Spieler')\n",
        "            plt.grid(axis='y', alpha=0.75)\n",
        "            plt.show()\n",
        "        else:\n",
        "            print(\"Keine Spieler mit dieser Mindest-Overall-Bewertung gefunden.\")\n",
        "\n",
        "overall_slider.observe(update_plot, names='value')\n",
        "\n",
        "print(\"\\nSpielerstatistik-Visualisierung:\")\n",
        "display(overall_slider, plot_output)\n",
        "\n",
        "# Initialen Plot erstellen\n",
