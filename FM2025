    {
      "cell_type": "code",
      "source": [
        "# Dropdown für Team-Filter\n",
        "team_options = ['All Teams'] + list(df_players['team'].unique())\n",
        "team_selector = widgets.Dropdown(\n",
        "    options=team_options,\n",
        "    value='All Teams',\n",
        "    description='Team:',\n",
        "    disabled=False,\n",
        ")\n",
        "\n",
        "# Output-Widget, um die Ergebnisse anzuzeigen\n",
        "output_players = widgets.Output()\n",
        "\n",
        "def filter_players(change):\n",
        "    with output_players:\n",
        "        clear_output(wait=True)\n",
        "        selected_team = change.new\n",
        "        if selected_team == 'All Teams':\n",
        "            display(df_players)\n",
        "        else:\n",
        "            display(df_players[df_players['team'] == selected_team])\n",
        "\n",
        "team_selector.observe(filter_players, names='value')\n",
        "\n",
        "print(\"Spielerliste:\")\n",
        "display(team_selector, output_players)\n",
        "\n",
        "# Initialen Aufruf, um alle Spieler anzuzeigen\n",
        "with output_players:\n",
        "    display(df_players)"
