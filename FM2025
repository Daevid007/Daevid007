    {
      "cell_type": "code",
      "source": [
        "# Beispiel für Spielerdaten\n",
        "players_data = [\n",
        "    {\"name\": \"Lionel Messi\", \"overall\": 95, \"position\": \"ST\", \"team\": \"FC Barcelona\"},\n",
        "    {\"name\": \"Cristiano Ronaldo\", \"overall\": 92, \"position\": \"ST\", \"team\": \"Real Madrid\"},\n",
        "    {\"name\": \"Kevin De Bruyne\", \"overall\": 91, \"position\": \"CM\", \"team\": \"Manchester City\"},\n",
        "    {\"name\": \"Robert Lewandowski\", \"overall\": 90, \"position\": \"ST\", \"team\": \"FC Bayern München\"},\n",
        "    {\"name\": \"Virgil van Dijk\", \"overall\": 89, \"position\": \"CB\", \"team\": \"Liverpool FC\"},\n",
        "    {\"name\": \"Neymar Jr.\", \"overall\": 88, \"position\": \"LW\", \"team\": \"Paris Saint-Germain\"},\n",
        "]\n",
        "\n",
        "df_players = pd.DataFrame(players_data)"
      ],
      "metadata": {
        "id": "7v4xJXXXGVtt"
      },
      "execution_count": 8,
      "outputs": []
