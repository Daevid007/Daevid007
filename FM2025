        "# Teams für die Simulation (könnten auch über Widgets ausgewählt werden)\n",
        "team_a = \"FC Bayern München\"\n",
        "team_b = \"Borussia Dortmund\"\n",
        "\n",
        "# Button, um ein Spiel zu simulieren\n",
        "simulate_button = widgets.Button(description=\"Spiel simulieren\")\n",
        "game_output = widgets.Output()\n",
        "\n",
        "def simulate_game(b):\n",
        "    with game_output:\n",
        "        clear_output(wait=True)\n",
        "        score_a = random.randint(0, 4)\n",
        "        score_b = random.randint(0, 4)\n",
        "        print(f\"Spiel zwischen {team_a} und {team_b}:\")\n",
        "        print(f\"Ergebnis: {team_a} {score_a} - {score_b} {team_b}\")\n",
        "        if score_a > score_b:\n",
        "            print(f\"{team_a} hat gewonnen!\")\n",
        "        elif score_b > score_a:\n",
        "            print(f\"{team_b} hat gewonnen!\")\n",
        "        else:\n",
        "            print(\"Das Spiel endete unentschieden.\")\n",
        "\n",
        "simulate_button.on_click(simulate_game)\n",
        "\n",
        "print(\"\\nSpielsimulation:\")\n",
        "display(simulate_button, game_output)"
